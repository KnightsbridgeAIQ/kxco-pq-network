{
  "name": "kxco-pq-network",
  "version": "1.1.1",
  "description": "Three levels of proof for post-quantum envelopes: the signature offline, an Armature L1 anchor offline, and a live key-registry check that catches a revoked key and fails closed. Shared across the kxco-pq packages.",
  "keywords": [
    "post-quantum",
    "pqc",
    "ml-dsa",
    "verification",
    "revocation",
    "key-registry",
    "anchoring",
    "armature",
    "kxco",
    "identity",
    "compliance",
    "fail-closed",
    "pqc-migration",
    "crypto-agility",
    "digital-signature",
    "non-repudiation",
    "tamper-evident",
    "key-revocation",
    "signature-verification",
    "air-gapped"
  ],
  "license": "Apache-2.0",
  "author": "Shayne Heffernan and John Heffernan",
  "contributors": [
    {
      "name": "Shayne Heffernan"
    },
    {
      "name": "John Heffernan"
    }
  ],
  "homepage": "https://kxco.ai",
  "repository": {
    "type": "git",
    "url": "https://github.com/KnightsbridgeAIQ/kxco-pq-network.git"
  },
  "bugs": {
    "url": "https://github.com/KnightsbridgeAIQ/kxco-pq-network/issues"
  },
  "type": "module",
  "sideEffects": false,
  "main": "./src/index.js",
  "types": "./src/index.d.ts",
  "exports": {
    ".": {
      "types": "./src/index.d.ts",
      "import": "./src/index.js"
    }
  },
  "files": [
    "CHANGELOG.md",
    "LICENSE",
    "NOTICE",
    "README.md",
    "SALES-SKU.md",
    "src",
    "ASSESSMENT.md"
  ],
  "engines": {
    "node": ">=20.19"
  },
  "dependencies": {
    "kxco-post-quantum": "^1.6.0"
  },
  "scripts": {
    "test": "node --test --test-timeout=30000 test/network.test.js test/registry.test.js test/property.test.js test/ml-dsa-87.test.js",
    "evidence": "node scripts/build-evidence.mjs"
  },
  "funding": "https://kxco.ai",
  "publishConfig": {
    "provenance": true,
    "access": "public"
  },
  "devDependencies": {
    "fast-check": "4.10.2"
  }
}
